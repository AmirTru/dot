#!/usr/bin/env bash
# Blocks the commit when any test fails. Enabled by: git config core.hooksPath scripts/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! scripts/test.sh > /tmp/dot-precommit.log 2>&1; then
  tail -20 /tmp/dot-precommit.log
  echo "pre-commit: tests failed, commit blocked" >&2
  exit 1
fi
echo "pre-commit: all tests passed"
